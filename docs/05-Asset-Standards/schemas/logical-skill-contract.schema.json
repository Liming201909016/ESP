{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://esp.example/schemas/logical-skill-contract.schema.json",
  "title": "ESP Logical Skill Invocation",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "skillCode": {
      "enum": [
        "LS-SEC-DOC-INTAKE",
        "LS-SEC-EVIDENCE-EXTRACT",
        "LS-SEC-REVIEW",
        "LS-SEC-RISK-RATING",
        "LS-SEC-REPORT-GEN"
      ]
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "sourceVersion", "uri", "classification"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "sourceVersion": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "format": "uri" },
        "classification": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "type", "sourceId", "claimReference"],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 1 },
        "type": { "enum": ["Fact", "RuleResult", "ToolResult", "ModelSuggestion", "HumanDecision"] },
        "sourceId": { "type": "string", "minLength": 1 },
        "claimReference": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "message", "retryable"],
      "properties": {
        "category": { "enum": ["InvalidInput", "MissingEvidence", "DependencyFailure", "PolicyDenial", "Timeout", "InternalFailure"] },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "detailReference": { "type": "string", "format": "uri" }
      }
    },
    "normalizedContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestTypes"],
      "properties": {
        "requestTypes": { "type": "array", "minItems": 1, "items": { "enum": ["RG", "APP", "FW", "CR", "AR"] } },
        "projectSummary": { "type": "string" },
        "systems": { "type": "array", "items": { "type": "string" } },
        "identities": { "type": "array", "items": { "type": "string" } },
        "dataFlows": { "type": "array", "items": { "type": "string" } },
        "integrations": { "type": "array", "items": { "type": "string" } },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "changes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "sourceId"],
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "sourceId": { "type": "string", "minLength": 1 }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceIds", "description"],
      "properties": {
        "sourceIds": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findingId", "statement", "authority", "evidenceIds"],
      "properties": {
        "findingId": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "authority": { "enum": ["MandatoryRunbook", "AdvisoryMicrosoft", "AdvisoryIndustry"] },
        "evidenceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "analystDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findingId", "decision"],
      "properties": {
        "findingId": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["Accept", "Modify", "Reject", "Escalate", "CannotAssess"] },
        "rationale": { "type": "string" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageType", "contractVersion", "correlationId", "useCaseCode", "consumerBindingCode", "skillCode", "classification", "payload", "sourceReferences"],
      "properties": {
        "messageType": { "const": "request" },
        "contractVersion": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
        "correlationId": { "type": "string", "minLength": 1 },
        "useCaseCode": { "type": "string", "minLength": 1 },
        "consumerBindingCode": { "type": "string", "minLength": 1 },
        "skillCode": { "$ref": "#/$defs/skillCode" },
        "classification": { "type": "string", "minLength": 1 },
        "payload": { "type": "object" },
        "sourceReferences": { "type": "array", "items": { "$ref": "#/$defs/sourceReference" } }
      },
      "allOf": [
        { "if": { "properties": { "skillCode": { "const": "LS-SEC-DOC-INTAKE" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/documentIntakeRequest" } } } },
        { "if": { "properties": { "skillCode": { "const": "LS-SEC-EVIDENCE-EXTRACT" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/evidenceExtractRequest" } } } },
        { "if": { "properties": { "skillCode": { "const": "LS-SEC-REVIEW" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/securityReviewRequest" } } } },
        { "if": { "properties": { "skillCode": { "const": "LS-SEC-RISK-RATING" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/riskRatingRequest" } } } },
        { "if": { "properties": { "skillCode": { "const": "LS-SEC-REPORT-GEN" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/reportRequest" } } } }
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageType", "contractVersion", "correlationId", "skillCode", "logicalSkillVersion", "implementationVersion", "outcome", "payload", "evidence", "oversight", "errors"],
      "properties": {
        "messageType": { "const": "response" },
        "contractVersion": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
        "correlationId": { "type": "string", "minLength": 1 },
        "skillCode": { "$ref": "#/$defs/skillCode" },
        "logicalSkillVersion": { "type": "string", "minLength": 1 },
        "implementationVersion": { "type": "string", "minLength": 1 },
        "outcome": { "enum": ["Success", "NeedsInformation", "CannotAssess", "HumanHandoff", "RejectedByPolicy", "Failed"] },
        "payload": { "type": "object" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceItem" } },
        "oversight": { "enum": ["NotRequired", "ReviewRequired", "ApprovalRequired", "Completed"] },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } }
      },
      "allOf": [
        { "if": { "properties": { "skillCode": { "const": "LS-SEC-DOC-INTAKE" }, "outcome": { "const": "Success" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/documentIntakeResponse" } } } },
        { "if": { "properties": { "skillCode": { "const": "LS-SEC-EVIDENCE-EXTRACT" }, "outcome": { "const": "Success" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/evidenceExtractResponse" } } } },
        { "if": { "properties": { "skillCode": { "const": "LS-SEC-REVIEW" }, "outcome": { "const": "Success" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/securityReviewResponse" } } } },
        { "if": { "properties": { "skillCode": { "const": "LS-SEC-RISK-RATING" }, "outcome": { "const": "Success" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/riskRatingResponse" } } } },
        { "if": { "properties": { "skillCode": { "const": "LS-SEC-REPORT-GEN" }, "outcome": { "const": "Success" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/reportResponse" } } } }
      ]
    },
    "documentIntakeRequest": { "type": "object", "additionalProperties": false, "required": ["projectDescription", "documents"], "properties": { "projectDescription": { "type": "string", "minLength": 1 }, "documents": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
    "documentIntakeResponse": { "type": "object", "additionalProperties": false, "required": ["normalizedContext", "requestTypes", "materialComplete", "sourceInventory", "dataGaps"], "properties": { "normalizedContext": { "$ref": "#/$defs/normalizedContext" }, "requestTypes": { "type": "array", "items": { "enum": ["RG", "APP", "FW", "CR", "AR"] } }, "materialComplete": { "type": "boolean" }, "sourceInventory": { "type": "array", "items": { "type": "string" } }, "dataGaps": { "type": "array", "items": { "type": "string" } } } },
    "evidenceExtractRequest": { "type": "object", "additionalProperties": false, "required": ["normalizedContext", "sourceInventory"], "properties": { "normalizedContext": { "$ref": "#/$defs/normalizedContext" }, "sourceInventory": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
    "evidenceExtractResponse": { "type": "object", "additionalProperties": false, "required": ["facts", "conflicts", "dataGaps"], "properties": { "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } }, "conflicts": { "type": "array", "items": { "$ref": "#/$defs/conflict" } }, "dataGaps": { "type": "array", "items": { "type": "string" } } } },
    "securityReviewRequest": { "type": "object", "additionalProperties": false, "required": ["normalizedContext", "evidenceItems", "runbookReference"], "properties": { "normalizedContext": { "$ref": "#/$defs/normalizedContext" }, "evidenceItems": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceItem" } }, "runbookReference": { "type": "string", "format": "uri" } } },
    "securityReviewResponse": { "type": "object", "additionalProperties": false, "required": ["findings", "questions", "requiredActions", "cannotAssessItems"], "properties": { "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }, "questions": { "type": "array", "items": { "type": "string" } }, "requiredActions": { "type": "array", "items": { "type": "string" } }, "cannotAssessItems": { "type": "array", "items": { "type": "string" } } } },
    "riskRatingRequest": { "type": "object", "additionalProperties": false, "required": ["findings", "methodReference"], "properties": { "findings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/finding" } }, "methodReference": { "type": "string", "format": "uri" } } },
    "riskRatingResponse": { "type": "object", "additionalProperties": false, "required": ["proposedRating", "rationale", "supportingEvidenceIds", "humanConfirmationRequired"], "properties": { "proposedRating": { "enum": ["Blocker", "High", "Medium", "Low", "Info", "Unrated"] }, "rationale": { "type": "string" }, "supportingEvidenceIds": { "type": "array", "items": { "type": "string" } }, "humanConfirmationRequired": { "const": true } } },
    "reportRequest": { "type": "object", "additionalProperties": false, "required": ["analystDispositions", "templateReference"], "properties": { "analystDispositions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/analystDisposition" } }, "templateReference": { "type": "string", "format": "uri" } } },
    "reportResponse": { "type": "object", "additionalProperties": false, "required": ["reportArtifactReference", "documentStatus", "citationsPreserved"], "properties": { "reportArtifactReference": { "type": "string", "format": "uri" }, "documentStatus": { "enum": ["Draft", "Final"] }, "citationsPreserved": { "const": true } } }
  }
}