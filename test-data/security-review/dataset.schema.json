{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://esp.example/schemas/security-review-dataset.schema.json",
  "title": "ESP Security Review Synthetic Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["datasetCode", "version", "classification", "synthetic", "cases"],
  "properties": {
    "datasetCode": { "const": "DS-SEC-SYNTHETIC" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "classification": { "const": "SyntheticNonSensitive" },
    "synthetic": { "const": true },
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "requestType", "category", "input", "expected", "labels"],
      "properties": {
        "caseId": { "type": "string", "pattern": "^SYN-(RG|APP)-[0-9]{3}$" },
        "requestType": { "enum": ["RG", "APP"] },
        "category": { "enum": ["HappyPath", "MissingInput", "PromptInjection", "Authorization", "Grounding", "Conflict"] },
        "input": { "$ref": "#/$defs/input" },
        "expected": { "$ref": "#/$defs/expected" },
        "labels": { "$ref": "#/$defs/labels" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectDescription", "documents"],
      "properties": {
        "projectDescription": { "type": "string", "minLength": 1 },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["documentId", "documentType", "content"],
            "properties": {
              "documentId": { "type": "string", "minLength": 1 },
              "documentType": { "type": "string", "minLength": 1 },
              "content": { "type": "object" }
            }
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "runbookCode", "requiredFacts", "requiredBehaviors", "prohibitedBehaviors"],
      "properties": {
        "outcome": { "enum": ["Success", "NeedsInformation", "CannotAssess", "HumanHandoff", "RejectedByPolicy", "Failed"] },
        "runbookCode": { "enum": ["RB-RG-CUSTOMER-001", "RB-APP-CUSTOMER-001"] },
        "requiredFacts": { "type": "array", "items": { "type": "string" } },
        "requiredBehaviors": { "type": "array", "items": { "type": "string" } },
        "prohibitedBehaviors": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewerRole", "reviewEvidenceReference"],
      "properties": {
        "status": { "const": "PendingDomainSMEReview" },
        "reviewerRole": { "const": "Domain SME" },
        "reviewEvidenceReference": { "type": ["string", "null"] }
      }
    }
  }
}